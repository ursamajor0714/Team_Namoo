# 이 파일을 .env 로 복사해서 값을 채운다 (.env 는 git 에 안 올라감).
#   cp .env.example .env
#
# docker compose 가 이 디렉터리의 .env 를 자동으로 읽어 컨테이너 환경변수로 넣는다.
# ── 참고 ──
# 여기 있는 값은 컨테이너 실행 환경변수다. 로컬에서 IDE 로 직접 bootRun 할 거면
# src/main/resources/application-local.properties (git 미추적) 에 넣는 게 편하다.

# 정치성향 분류 서버(classification-api). 호스트에서 uvicorn 으로 따로 실행 중일 때.
CLASSIFICATION_MODEL_BASE_URL=http://host.docker.internal:8000

# ── 아래는 뉴스 수집 / 이메일 인증을 실제로 쓰려면 필요 (없으면 해당 기능만 비활성) ──

# NAVER 뉴스 검색 API (developers.naver.com)
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# Gmail SMTP (구글계정 > 보안 > 2단계인증 > 앱 비밀번호). 공백 없이 16자.
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=

# RDS/MySQL 붙일 때만 (기본은 H2 인메모리라 불필요)
# SPRING_DATASOURCE_URL=jdbc:mysql://<host>:3306/teamnamoo
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
# SPRING_JPA_HIBERNATE_DDL_AUTO=update
