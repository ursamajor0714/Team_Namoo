# Team_Namoo Spring 백엔드 배포용 환경변수 템플릿.
# 실제 값을 채운 파일은 EC2 의 /home/ec2-user/app/namoo-spring.env 에 두고,
# 절대 git 에 커밋하지 않는다 (.gitignore 에서 *.env 제외됨).

# --- DB (RDS MySQL) ---
SPRING_DATASOURCE_URL=jdbc:mysql://namoo-db.cjkcywue246k.ap-northeast-2.rds.amazonaws.com:3306/teamnamoo
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_RDS_MASTER_PASSWORD
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_H2_CONSOLE_ENABLED=false

# --- NAVER 뉴스 검색 API ---
NAVER_CLIENT_ID=CHANGE_ME
NAVER_CLIENT_SECRET=CHANGE_ME

# --- 이메일 인증용 Gmail SMTP (발신 전용 계정의 앱 비밀번호) ---
SPRING_MAIL_USERNAME=CHANGE_ME@gmail.com
SPRING_MAIL_PASSWORD=CHANGE_ME_16_CHAR_APP_PASSWORD

# --- 팀원 분류 서버 (나중에 팀원 EC2 Elastic IP 로 채움) ---
CLASSIFICATION_MODEL_BASE_URL=http://CHANGE_ME:8000

# --- Caddy(HTTPS 리버스프록시) 뒤에서 세션쿠키 크로스오리진 동작용 ---
# Amplify(https) -> 이 API(https, 다른 도메인) withCredentials 요청 대응.
SERVER_FORWARD_HEADERS_STRATEGY=framework
SERVER_SERVLET_SESSION_COOKIE_SAME_SITE=none
SERVER_SERVLET_SESSION_COOKIE_SECURE=true

# --- CORS 허용 origin (쉼표 구분). 기본값에 Amplify 주소가 이미 있으므로
#     보통 생략 가능. 커스텀 도메인 붙이면 여기에 추가. ---
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://main.d11ftaq8rgsma0.amplifyapp.com
